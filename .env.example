AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=75
AI_CONNECT_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.55
AI_MAX_OUTPUT_TOKENS=3500
AI_JSON_MODE=true
VYRO_SERVICE_API_KEY=

# Optional image generation. Keep this key server-side; it is never sent to the browser.
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2.6-flare
IMAGE_QUALITY=medium
IMAGE_TIMEOUT_SECONDS=180
IMAGE_MAX_OUTPUT_BYTES=20971520
IMAGE_OUTPUT_DIR=./image_outputs
IMAGE_RETENTION_HOURS=48
